{
  "expo": {
    "name": "sentry-spike",
    "slug": "sentry-spike",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sentryspike",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.giosferrazza.sentryspike",
      "appleTeamId": "72TAPSBT32",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "NSLocationWhenInUseUsageDescription": "Sentry checks when you arrive at a location you set, so it can nudge you to pause.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Sentry needs Always access so it can detect arrivals even when the app is in the background.",
        "NSLocationAlwaysUsageDescription": "Sentry needs Always access so it can detect arrivals even when the app is in the background."
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.giosferrazza.sentryspike"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.giosferrazza.sentryspike"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Sentry needs Always access so it can detect arrivals even when the app is in the background.",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "./plugins/withoutPushEntitlement",
      "expo-notifications",
      "expo-image",
      "expo-web-browser",
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
